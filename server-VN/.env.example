# ===== Server =====
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info

# ===== AI Provider =====
# gemini | groq
LLM_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq (LLM + STT)
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.1-8b-instant
GROQ_STT_MODEL=whisper-large-v3

# OpenAI Whisper fallback (optional)
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1

# ===== TTS =====
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=+0%
TTS_VOLUME=+0%

# ===== WebSocket protocol behavior =====
WS_PROTOCOL_VERSION=3
WS_AUDIO_SAMPLE_RATE=24000
WS_AUDIO_FRAME_DURATION=60
